# All keys are optional. Without any key RED still scans the website, the tracking
# stack (incl. GTM containers), SEO/sitemaps, the AI-crawler stance, Wayback
# positioning history, App Store, Hacker News, and — the part that matters for
# distribution — the public Atom feed of every community you name.

# Unlocks ad libraries (Meta, Google, LinkedIn), TikTok/IG/YouTube/X/LinkedIn
# stats, founder discovery and Reddit search. ~25–50 credits per full run.
# https://scrapecreators.com
SCRAPECREATORS_API_KEY=

# Unlocks the written distribution report (`red <url>` without --no-ai).
# Not needed when you use RED through MCP — your agent writes the report.
ANTHROPIC_API_KEY=

# Optional overrides
# RED_MODEL=claude-opus-5
# RED_MAX_CREDITS=50
# RED_REDDIT_DELAY_MS=60000
# RED_USER_AGENT=
# RED_NO_CACHE=1
